{
  "mcpServers": {
    "mysql-local": {
      "command": "npx",
      "args": ["-y", "@benborla29/mcp-server-mysql@2.0.9"],
      "env": {
        "MYSQL_HOST": "127.0.0.1",
        "MYSQL_PORT": "8085",
        "MYSQL_USER": "root",
        "MYSQL_PASS": "${MYSQL_PASS:-}",
        "MYSQL_DB": "turbo_kofe",
        "ALLOW_INSERT_OPERATION": "false",
        "ALLOW_UPDATE_OPERATION": "false",
        "ALLOW_DELETE_OPERATION": "false"
      }
    }
  }
}
