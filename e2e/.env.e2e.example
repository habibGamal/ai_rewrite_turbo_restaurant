# Copy to .env.e2e (stack.sh does it on first run). .env.e2e is git-ignored.

# Where the two repos live, relative to this e2e/ folder.
POS_DIR=..
SITE_DIR=../../turbo_tenant

# Host ports
SITE_PORT=8000
POS_PORT=8001
MAILPIT_PORT=8025
DB_PORT=33306

# Shared secrets between POS and website (test-only values; change if you like).
E2E_WEB_API_KEY=193b6c8a03c1e8d097b8b942ded69113448c1239c66c47ba
E2E_INTEGRATION_TOKEN=6f116e325584c28f9df277036fec3b9567db489bfc9e28f7

# Paymob TEST credentials (accept.paymob.com dashboard, test mode). Leave empty to keep online payment off.
E2E_PAYMOB_SECRET_KEY=
E2E_PAYMOB_PUBLIC_KEY=
E2E_PAYMOB_INTEGRATION_IDS=
E2E_PAYMOB_HMAC_SECRET=
# Paymob test card used by the payment test.
E2E_PAYMOB_TEST_CARD_NUMBER=
E2E_PAYMOB_TEST_CARD_EXPIRY=
E2E_PAYMOB_TEST_CARD_CVV=
E2E_PAYMOB_TEST_CARDHOLDER=

# Cloudflare tunnel. Empty = free quick tunnel with a new *.trycloudflare.com URL each start.
# For a fixed URL, create a tunnel in Cloudflare Zero Trust that routes your hostname to
# http://site:8000, then fill both lines:
CLOUDFLARE_TUNNEL_TOKEN=
E2E_TUNNEL_HOSTNAME=
# E2E_TUNNEL_COMMAND="tunnel --no-autoupdate run"

# Agent for agent.act/agent.assert steps: agy | none
E2E_AGENT=agy
# Exact model name as agy lists it (e2e prints the list if this is wrong).
E2E_AGY_MODEL=
